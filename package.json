{
  "name": "vaultlance-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:clips": "node scripts/gen-clip-manifest.mjs",
    "gen:docs": "node scripts/gen-api-docs.mjs",
    "predev": "npm run gen:clips",
    "dev": "vite",
    "prebuild": "npm run gen:clips",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "e2e:smoke": "node --env-file=backend/.env --env-file=backend/.env.E2E scripts/e2e-smoke.mjs",
    "benchmark:routes": "node --env-file=backend/.env.E2E scripts/benchmark-routes.mjs",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "analyze": "vite-bundle-visualizer -t raw-data -o docs/laws-audit/bundle.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@hookform/resolvers": "^6.0.2",
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "fflate": "^0.8.2",
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.1.0"
  }
}
