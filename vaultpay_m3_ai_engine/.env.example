# ─────────────────────────────────────────────────────────────────────────────
#  VaultPay – Environment Configuration (copy to .env and fill in values)
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vaultpay:vaultpay@localhost:5432/vaultpay
DATABASE_SYNC_URL=postgresql://vaultpay:vaultpay@localhost:5432/vaultpay

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_CHUNKS=vaultpay_chunks

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-opus-20240229
# Maximum tokens allowed in a single LLM call
CLAUDE_MAX_TOKENS=4096

# ── PayPal Sandbox ────────────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Redis / Celery (task queue) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File upload limits ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_EXPANDED_MB=200
MAX_ZIP_ENTRY_COUNT=500
MAX_ZIP_NESTING_DEPTH=3
UPLOAD_DIR=uploads
TEMP_EXTRACT_DIR=/tmp/vaultpay_extract

# ── Prompt / extractor versioning (bump when you change prompts) ───────────────
PROMPT_VERSION=1.0.0
EXTRACTOR_VERSION=1.0.0
